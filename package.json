{
  "name": "justcode",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "scripts": {
    "predev": "node tools/vendor-file-icons.mjs",
    "dev": "vite",
    "prebuild": "node tools/vendor-file-icons.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "node scripts/pack.mjs",
    "build:packed": "tauri build && node scripts/pack.mjs",
    "tauri": "tauri",
    "sync:associations": "node tools/sync-associations.mjs",
    "check:associations": "node tools/sync-associations.mjs --check",
    "test": "npm run check:file-icons && npm run test:js && npm run test:rust",
    "test:js": "node --test \"tests/**/*.test.js\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib --target-dir src-tauri/target-test",
    "vendor:file-icons": "node tools/vendor-file-icons.mjs --force",
    "check:file-icons": "node tools/vendor-file-icons.mjs --check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "acorn": "^8.14.1",
    "dictionary-en": "^4.0.0",
    "marked": "^18.0.6",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "material-icon-theme": "^5.38.1",
    "vite": "^6.2.0"
  }
}
